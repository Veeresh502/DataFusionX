  "liveNow": false,
  "panels": [
    {
      "title": "API Request Rate (req/sec)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 0 },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "rate(http_requests_total[1m])",
          "legendFormat": "{{method}} {{endpoint}} ({{status}})"
        }
      ]
    },
    {
      "title": "API Request Latency (p95)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 0 },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket[1m])) by (le, endpoint))",
          "legendFormat": "p95 {{endpoint}}"
        }
      ]
    },
    {
      "title": "API Errors Total",
      "type": "stat",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 0 },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "HTTP_ERRORS_TOTAL or vector(0)",
          "legendFormat": "Errors"
        }
      ]
    },
    {
      "title": "Overall Pipeline Executions Summary",
      "type": "stat",
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "pipeline_exec_success_count",
          "legendFormat": "Successful Executions"
        },
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "pipeline_exec_failed_count",
          "legendFormat": "Failed Executions"
        }
      ]
    },
    {
      "title": "Overall Pipeline Duration (Avg)",
      "type": "stat",
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "pipeline_exec_avg_duration_seconds",
          "legendFormat": "Avg Duration (sec)"
        }
      ]
    },

